// test 1. basic && and ||
print(true && true);   // true
print(true && false);  // false
print(false || true);  // true
print(false || false); // false

// test 2. ! (already worked before, still should)
print(!true);  // false
print(!false); // true

// test 3. precedence: && binds tighter than ||
print(true || false && false); // true  -> true || (false && false)

// test 4. combined with comparisons
let a = 5;
let b = 10;
print(a < b && b < 20); // true
print(a > b || b == 10); // true

// test 5. short-circuiting: sideEffect() should never be called/printed
fn sideEffect() {
    print("side effect ran");
    return true;
}

print(false && sideEffect()); // false, "side effect ran" must NOT print
print(true || sideEffect());  // true, "side effect ran" must NOT print
print(true && sideEffect());  // true, "side effect ran" SHOULD print
